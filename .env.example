# Copy to .env and fill in. The .env file itself is gitignored.

# --- Backend (functions) secrets ---
# Set via `firebase functions:secrets:set` in production; only needed locally.
FINNHUB_API_KEY=
EODHD_API_KEY=
FMP_API_KEY=
OPENFIGI_API_KEY=

# --- Firebase App Check (frontend, build-time) ---
# All public values, safe to ship in the client bundle. Get them from the
# Firebase console: Project settings → your web app (firebaseConfig), and
# App Check → reCAPTCHA v3 site key. Leave blank to disable App Check on the
# client (the app then calls the API without a token).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=

# --- Backend App Check enforcement (functions runtime) ---
# Set to "true" on the `api` function ONLY after the client is deployed and
# sending tokens; otherwise real users are locked out. Roll out in monitor mode
# (unset/false) first. Reject invalid/missing tokens when "true".
APP_CHECK_ENFORCED=
